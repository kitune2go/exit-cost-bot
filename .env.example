# Public deployment protection
REQUIRE_AUTH=false
APP_USERNAME=exit
APP_PASSWORD=
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MINUTES=10

# OpenAI mode
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Optional: self-hosted / OpenAI-compatible mode
# If LLM_BASE_URL is set, EXIT COST uses this endpoint instead of OpenAI Responses API.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

PORT=3000
